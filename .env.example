# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust. `.env` is git-ignored.
#
# For local development you may set plaintext passwords below; the server will
# bcrypt-hash them in memory at boot. For PRODUCTION, set the pre-hashed
# variants (SITE_PASSWORD_HASH / ADMIN_PASSWORD_HASH) instead — generate them
# with:  npm run hash-password -- "your-password"
# ---------------------------------------------------------------------------

# Secret used to sign the admin session JWT. MUST be long and random in production.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# --- Admin gate (needed to open /admin and trigger crawls) ---
# The public app has NO password; only /admin is protected.
ADMIN_PASSWORD=admin-2026
# ADMIN_PASSWORD_HASH=$2a$10$....  # takes precedence over ADMIN_PASSWORD

# Session lifetime.
SESSION_TTL_HOURS=12
